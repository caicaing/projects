[Unit]
Description=Taskflow scheduler and Web gateway
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=taskflow
Group=taskflow
WorkingDirectory=/opt/taskflow
ExecStart=@NODE@ /opt/taskflow/scripts/dev.mjs \
    --backend-config /etc/taskflow/backend.yaml \
    --frontend-config /etc/taskflow/frontend.yaml
Restart=always
RestartSec=5s
TimeoutStopSec=25s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/taskflow

[Install]
WantedBy=multi-user.target
