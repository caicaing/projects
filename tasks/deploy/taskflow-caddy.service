[Unit]
Description=Taskflow Caddy HTTPS gateway
Wants=network-online.target
After=network-online.target taskflow.service

[Service]
Type=simple
User=taskflow
Group=taskflow
ExecStart=@CADDY@ run --config /etc/taskflow/Caddyfile --adapter caddyfile
ExecReload=@CADDY@ reload --config /etc/taskflow/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
UMask=0077
Environment=XDG_DATA_HOME=/var/lib/taskflow/caddy/data
Environment=XDG_CONFIG_HOME=/var/lib/taskflow/caddy/config
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/taskflow/caddy

[Install]
WantedBy=multi-user.target
